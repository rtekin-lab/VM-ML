# 4. GPU bilgisi
!nvidia-smi
import torch
print(f"CUDA: {torch.cuda.is_available()}")
print(f"GPU: {torch.cuda.get_device_name(0) if torch.cuda.is_available() else 'Yok'}")

# 5. TPU kontrolü
try:
    import torch_xla.core.xla_model as xm
    device = xm.xla_device()
    print(f"TPU: {device}")
except ImportError:
    print("TPU: Mevcut degil")

