# ─── Yontem 5: Google Cloud Storage ─────────────────────────────
from google.cloud import storage
client = storage.Client()
bucket = client.bucket("benim-kovam")
blob = bucket.blob("veri/buyuk_dosya.parquet")
blob.download_to_filename("/content/buyuk_dosya.parquet")
df = pd.read_parquet("/content/buyuk_dosya.parquet")
